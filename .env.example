# Salin jadi .env.local, lalu isi. Jangan pernah commit .env.local.

NEXT_PUBLIC_APP_NAME=Fondasi
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nama yang tercetak di kuitansi sebagai penerima pembayaran.
BUSINESS_NAME=Nama Usahamu

# Supabase (Project Settings -> API Keys).
# Secret key HANYA untuk server, jangan pernah diawali NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Pembayaran. Driver bawaan: midtrans.
PAYMENT_DRIVER=midtrans
# Midtrans (Settings -> Access Keys, dashboard dalam mode Sandbox).
# Tergantung akunnya, key sandbox diawali SB-Mid- atau langsung Mid-.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Email lewat SMTP standar (Resend, Brevo, Amazon SES, dan lainnya).
# Kosongkan SMTP_HOST saat mencoba di lokal: email hanya dicetak ke log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Fondasi <halo@domainmu.com>"

# Rahasia untuk endpoint cron. Buat dengan: openssl rand -hex 32
CRON_SECRET=
